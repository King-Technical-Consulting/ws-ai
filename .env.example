# Copy to .env and fill in. Never commit .env.

# --- Core ---
WS_ENV=dev                                  # dev | prod
WS_LISTEN=:8080
WS_PUBLIC_URL=http://localhost:8080         # main app origin (https://app.example.com in prod)
WS_ARTIFACT_URL=http://localhost:8081       # separate origin for sandboxed artifacts (https://art.example.com)
WS_PREVIEW_DOMAIN=preview.localhost         # sandbox previews: {port}-{sandbox}.{WS_PREVIEW_DOMAIN}
WS_SESSION_SECRET=change-me-32-bytes-min    # HMAC key for session cookies

# --- Database ---
WS_DATABASE_URL=postgres://ws:ws@localhost:5432/ws?sslmode=disable

# --- Blob storage ---
WS_BLOB_DIR=./data/blobs

# --- Email (magic links, invites) ---
RESEND_API_KEY=
WS_EMAIL_FROM=ws@example.com

# --- Hosted model providers (any can be blank) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# --- Local inference endpoints (OpenAI-compatible) ---
# Declared in config/endpoints.yaml; these are referenced there by env name.
LLAMA_SERVER_URL=http://localhost:8000/v1
VLLM_URL=
MAC_STUDIO_URL=

# --- Secrets from Infisical (optional; cloud free tier or self-hosted) ---
# With these three set, ws logs in with the machine identity at boot, pulls
# every secret in the project/environment into its environment (recursive,
# references expanded), and refreshes every 5 minutes. Values already in
# this file win unless INFISICAL_OVERWRITE=1. Keep only the bootstrap here.
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENV=prod
# INFISICAL_PATH=/
# INFISICAL_SITE_URL=https://app.infisical.com
# MCP server sidecar (WS_DEPLOY_PROFILES=infisical): a second, least-privilege
# machine identity for the agent's mcp__infisical__* tools.
# INFISICAL_MCP_CLIENT_ID=
# INFISICAL_MCP_CLIENT_SECRET=
# INFISICAL_MCP_MASK=true                    # mask secret values in tool output
# WS_DEPLOY_PROFILES=                        # e.g. infisical; written to .env, picked up by make up / CD

# --- Coding sandboxes (worker; needs the Docker socket) ---
# WS_SANDBOX_IMAGE=ghcr.io/king-technical-consulting/ws-sandbox:latest
# WS_SANDBOX_NETWORK=ws_sandbox-net        # internal network from compose.yaml
# WS_SANDBOX_PROXY_URL=http://worker:3128   # egress proxy sandboxes must use
# WS_SANDBOX_RUNTIME=auto                   # auto | runc | runsc (gVisor if installed)
# WS_SANDBOX_MEMORY_MB=4096
# WS_SANDBOX_CPUS=2
# WS_SANDBOX_IDLE_STOP=15m
# WS_SANDBOX_REMOVE_AFTER=168h
# WS_EGRESS_ALLOW=                          # extra hosts, comma-separated
# WS_WORKER_URL=http://worker:8082          # serve relays sandbox files/PTY to the worker's internal API
# WS_INTERNAL_LISTEN=:8082
# WS_PREVIEW_HOST=                          # preview hostname pattern; default {port}-{id}.<WS_PREVIEW_DOMAIN>.
#                                           # Behind the homelab Traefik: WS_PREVIEW_HOST=ws-p-{port}-{id}.home.arpa
# WS_PREVIEW_PARENT=home.arpa               # parent domain for the Traefik preview router (override.traefik.yaml)
# DOCKER_GID=                               # host docker group id for the worker; `make up` derives it from the socket
# GitHub App (preferred): repo-scoped, hour-long installation tokens injected by the egress proxy for
# sandbox pushes, and PR creation from the worker. Create the app once (Settings -> Developer settings ->
# GitHub Apps): permissions Contents: read/write, Pull requests: read/write, Metadata: read; no webhook
# yet; install it on your account/org. Keys never enter a sandbox.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=                   # PEM; "\n"-escaped or base64 is fine
# GITHUB_APP_PRIVATE_KEY_FILE=/secrets/github-app.pem   # or a file: put it in ./secrets/ (mounted read-only at /secrets)
# GITHUB_APP_SLUG=                          # from the app URL, for the Admin install link
# GITHUB_TOKEN=                             # fallback personal token when no App is configured
# Claude Code launcher from the containers (docs/CLAUDE_CODE_JOBS.md, infra/launcher/README.md):
# every target is an ssh target; the key, ssh_config and targets file live in ./secrets/.
# WS_CC_TARGETS=/secrets/targets.toml       # launcher targets (type = "ssh" only inside the container)
# WS_CC_SSH_CONFIG=/secrets/ssh_config      # ssh -F file: key, user, host name, known_hosts per target
# WS_CC_DISPATCH=false                      # true lets spawn_job launch for real (owner only); off by default
# WS_CC_WEEKLY_CAP=0                        # soft cap on subscription launches per week; 0 counts only

# --- Deployment (Compose) ---
POSTGRES_PASSWORD=change-me
# Host binding for override.cloud.yaml / LAN testing (default loopback, 8080/8081)
# WS_BIND_ADDR=100.x.y.z
# WS_HTTP_PORT=8180
# WS_ART_PORT=8181
# WS_IMAGE=ghcr.io/king-technical-consulting/ws:latest       # pin to a commit sha for reproducible deploys
# WS_DEPLOY_HW=cloud                         # written by `make install-cd`; default HW for make targets
# WS_DEPLOY_INGRESS=traefik                  # written by `make install-cd`; default INGRESS for make targets
# CLOUDFLARE_TUNNEL_TOKEN=                  # --profile cloudflare
# TS_AUTHKEY=                               # --profile tailscale (tagged key, tag:ws)
# HF_TOKEN=                                 # vLLM model downloads (Spark override)

# --- Owner bootstrap ---
# First user to register with this email becomes owner (role=owner) and gets an invite auto-created.
WS_OWNER_EMAIL=jeremy@example.com

# Rented GPUs (PLAN M9). RUNPOD_API_KEY enables the provider; WS_RENTAL_API_KEY
# is the key every rented server requires (a long random string); HF_TOKEN
# reaches the machine for gated models. See infra/rental/README.md.
RUNPOD_API_KEY=
WS_RENTAL_API_KEY=
HF_TOKEN=
WS_RENTAL_DAILY_CAP_HOURS=8
WS_RENTAL_DISABLED=false
